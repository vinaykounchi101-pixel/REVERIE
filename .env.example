# =============================================================================
# REVERIE Environment Configuration Template (.env.example)
# Copy to .env for local runtime configuration. NEVER commit actual .env secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Backend Server & Profiles
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
APP_ENVIRONMENT=local
APP_PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/reverie_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# -----------------------------------------------------------------------------
# 3. Security & JWT Configuration
# -----------------------------------------------------------------------------
# Must be at least 256-bit / 32 characters in production
JWT_SECRET=reverie_dev_jwt_secret_key_change_in_production_min32chars!
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
AUTH_PASSWORD_RESET_EXPIRY=15
AUTH_OTP_EXPIRY=10
AUTH_OTP_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# 4. Email & Notification Configuration (Flexible Multi-Provider Strategy)
# -----------------------------------------------------------------------------
# Supported EMAIL_PROVIDER values: auto | resend | brevo | smtp | mock
# When set to 'auto', REVERIE dynamically selects in order:
#   1. Resend (if RESEND_API_KEY is present)
#   2. Brevo (if BREVO_API_KEY is present)
#   3. SMTP (if SPRING_MAIL_USERNAME / SMTP host is configured)
#   4. Mock/Dev fallback (console log)
EMAIL_PROVIDER=auto
MAIL_FROM_ADDRESS=concierge@reverie.luxury
MAIL_FROM_NAME=REVERIE Haute Horlogerie

# --- Option A: Resend REST API (https://resend.com) ---
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_API_URL=https://api.resend.com/emails

# --- Option B: Brevo (Sendinblue) REST API (https://brevo.com) ---
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# --- Option C: Standard SMTP (Gmail, Brevo SMTP Relay, Amazon SES, Postmark) ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email_or_brevo_login@domain.com
SPRING_MAIL_PASSWORD=your_app_password_or_brevo_smtp_key

# -----------------------------------------------------------------------------
# 5. Google OAuth 2.0 / Social Authentication
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# -----------------------------------------------------------------------------
# 6. E-Commerce & Luxury Business Policy Settings
# -----------------------------------------------------------------------------
CHECKOUT_SESSION_TIMEOUT=30
CHECKOUT_MAX_LINE_ITEMS=20
INVENTORY_LOW_STOCK_THRESHOLD=5
INVENTORY_RESERVATION_TIMEOUT=15
SHIPPING_DELIVERY_MIN_DAYS=3
SHIPPING_DELIVERY_MAX_DAYS=7
SHIPPING_FREE_THRESHOLD_PAISE=10000000
SHIPPING_DEFAULT_RATE_PAISE=50000
PRICING_DEFAULT_CURRENCY=INR
PRICING_TAX_RATE=18.0
LUXURY_HIGH_VALUE_THRESHOLD_PAISE=25000000
LUXURY_MAX_LIMITED_EDITION=1

# -----------------------------------------------------------------------------
# 7. Pluggable E-Commerce Provider Ports
# -----------------------------------------------------------------------------
# Payment provider: mock | razorpay | stripe
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
WEBHOOK_SECRET_STRIPE=your_stripe_webhook_secret

# Shipping provider: mock | shiprocket | dhl
SHIPPING_PROVIDER=mock
SHIPPING_API_KEY=your_courier_api_key_here
SHIPPING_API_SECRET=your_courier_api_secret_here
SHIPPING_CARRIER_NAME=DHL_EXPRESS

# Storage provider: local | supabase | s3
STORAGE_PROVIDER=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# AI & Notification providers: mock | dev
AI_PROVIDER=mock
NOTIFICATION_PROVIDER=dev

# -----------------------------------------------------------------------------
# 8. Frontend Configuration (reverie-next)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_DEFAULT_USER_EMAIL=client@reverie.app
NEXT_PUBLIC_DEFAULT_USER_PASSWORD=Password@123
